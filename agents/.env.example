# Copy to .env (already gitignored at the repo root) and fill in your key.
# Free key: https://aistudio.google.com/apikey — no billing/credit card required.
GEMINI_API_KEY=AIza...

# Optional: override the default model (must support structured JSON output).
# GEMINI_MODEL=gemini-2.5-flash

# Where the real Membership REST API (Spring Boot) is listening.
MEMBERSHIP_API_BASE_URL=http://localhost:8080

# Where the Membership Ops A2A agent server binds / is reached.
MEMBERSHIP_OPS_AGENT_HOST=127.0.0.1
MEMBERSHIP_OPS_AGENT_PORT=9999
MEMBERSHIP_OPS_AGENT_URL=http://127.0.0.1:9999
